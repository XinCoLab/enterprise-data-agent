# Copy this file to settings.env and adjust it for the local machine.
# Never put passwords or API keys in this file.

# Model tracing is opt-in because traces may contain questions, SQL, and data.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_PROJECT=generic-directory-data-agent
DATA_AGENT_MAX_RECURSIONS=10
LANGGRAPH_DEFAULT_RECURSION_LIMIT=6

# Agent defaults
DATA_AGENT_PROMPT_SOURCE=local
DATA_AGENT_LANGUAGE=en
DATA_AGENT_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Database adapter: postgresql, mysql, or duckdb
DATA_AGENT_DATABASE_BACKEND=postgresql

# PostgreSQL
DATA_AGENT_POSTGRES_HOST=127.0.0.1
DATA_AGENT_POSTGRES_PORT=5432
DATA_AGENT_POSTGRES_USER=
DATA_AGENT_POSTGRES_DATABASE=

# MySQL
DATA_AGENT_MYSQL_HOST=127.0.0.1
DATA_AGENT_MYSQL_PORT=3306
DATA_AGENT_MYSQL_USER=
DATA_AGENT_MYSQL_DATABASE=

# DuckDB
DATA_AGENT_DATABASE_PATH=

# Relative paths resolve from the DataAgent project root.
DATA_AGENT_KNOWLEDGE_ROOT=./knowledge
DATA_AGENT_KNOWLEDGE_IMPORT_ROOT=./runtime/knowledge
DATA_AGENT_CHECKPOINT_PATH=./runtime/state/conversation.sqlite
DATA_AGENT_MAIN_PROMPT_PATH=
